    <worksheet name='Change Drivers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>What drove the change: market size vs share (vs a year earlier)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='market_share_tableau' name='federated.0mk7shr4m0n1t0r5yn7h3t1c00' />
          </datasources>
          <datasource-dependencies datasource='federated.0mk7shr4m0n1t0r5yn7h3t1c00'>
            <column datatype='string' name='[Manufacturer]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Product]' role='dimension' type='nominal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='integer' name='[Units]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Units Year Earlier]' role='measure' type='quantitative' />
            <column caption='Units (comparable)' datatype='integer' name='[Calculation_7310000000000000012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Units Year Earlier]) THEN [Units] END' />
            </column>
            <column caption='Market Units (all brands)' datatype='integer' name='[Calculation_7310000000000000001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Month Date], [Product], [State] : SUM([Units])}' />
            </column>
            <column caption='Market Units Year Earlier' datatype='integer' name='[Calculation_7310000000000000002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Month Date], [Product], [State] : SUM([Units Year Earlier])}' />
            </column>
            <column caption='Market Units (comparable)' datatype='integer' name='[Calculation_7310000000000000013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Units Year Earlier]) THEN [Calculation_7310000000000000001] END' />
            </column>
            <column caption='Market Effect' datatype='real' default-format='n#,##0' name='[Calculation_7310000000000000009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_7310000000000000013]) - SUM([Calculation_7310000000000000002])) * SUM([Units Year Earlier]) / SUM([Calculation_7310000000000000002])' />
            </column>
            <column caption='Share Effect' datatype='real' default-format='n#,##0' name='[Calculation_7310000000000000010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_7310000000000000013]) * (SUM([Calculation_7310000000000000012]) / SUM([Calculation_7310000000000000013]) - SUM([Units Year Earlier]) / SUM([Calculation_7310000000000000002]))' />
            </column>
            <column-instance column='[Manufacturer]' derivation='None' name='[none:Manufacturer:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_7310000000000000009]' derivation='User' name='[usr:Calculation_7310000000000000009:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_7310000000000000010]' derivation='User' name='[usr:Calculation_7310000000000000010:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Month Date]' derivation='None' name='[none:Month Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Product]' derivation='None' name='[none:Product:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0mk7shr4m0n1t0r5yn7h3t1c00].[none:Month Date:qk]' filter-group='2' included-values='in-range'>
            <min>#2020-01-01#</min>
            <max>#2026-06-01#</max>
          </filter>
          <filter class='categorical' column='[federated.0mk7shr4m0n1t0r5yn7h3t1c00].[none:Manufacturer:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:Manufacturer:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0mk7shr4m0n1t0r5yn7h3t1c00].[none:Product:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:Product:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0mk7shr4m0n1t0r5yn7h3t1c00].[none:Region:nk]' filter-group='5'>
