      <aliases enabled='yes' />
      <column datatype='date' name='[Month Date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Interval]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Year]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[Month Num]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Half]' role='dimension' type='nominal' />
      <column datatype='string' name='[Partial Year]' role='dimension' type='nominal' />
      <column datatype='string' name='[Manufacturer]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Brand Order]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Product]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Tier Order]' role='dimension' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Units]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Units Year Earlier]' role='measure' type='quantitative' />
      <column caption='Units (comparable)' datatype='integer' name='[Calculation_7310000000000000012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([Units Year Earlier]) THEN [Units] END' />
      </column>
      <column caption='Market Units (all brands)' datatype='integer' name='[Calculation_7310000000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Month Date], [Product], [State] : SUM([Units])}' />
      </column>
      <column caption='Market Units Year Earlier' datatype='integer' name='[Calculation_7310000000000000002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Month Date], [Product], [State] : SUM([Units Year Earlier])}' />
      </column>
      <column caption='Market Units (comparable)' datatype='integer' name='[Calculation_7310000000000000013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([Units Year Earlier]) THEN [Calculation_7310000000000000001] END' />
      </column>
      <column caption='Units All Tiers' datatype='integer' name='[Calculation_7310000000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Month Date], [Manufacturer], [State] : SUM([Units])}' />
      </column>
      <column caption='Brand Share' datatype='real' default-format='p0.0%' name='[Calculation_7310000000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Units]) / SUM([Calculation_7310000000000000001])' />
      </column>
      <column caption='Tier Share' datatype='real' default-format='p0.0%' name='[Calculation_7310000000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Units]) / SUM([Calculation_7310000000000000003])' />
      </column>
      <column caption='Units Change %' datatype='real' default-format='p0.0%' name='[Calculation_7310000000000000006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Units Year Earlier]) &gt; 0 THEN SUM([Calculation_7310000000000000012]) / SUM([Units Year Earlier]) - 1 END' />
      </column>
      <column caption='Low Volume' datatype='boolean' name='[Calculation_7310000000000000007]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Calculation_7310000000000000012]) &lt; 50 OR SUM([Units Year Earlier]) &lt; 50' />
      </column>
      <column caption='Units Change % (safe)' datatype='real' default-format='p0.0%' name='[Calculation_7310000000000000008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT [Calculation_7310000000000000007] THEN [Calculation_7310000000000000006] END' />
      </column>
      <column caption='Market Effect' datatype='real' default-format='n#,##0' name='[Calculation_7310000000000000009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_7310000000000000013]) - SUM([Calculation_7310000000000000002])) * SUM([Units Year Earlier]) / SUM([Calculation_7310000000000000002])' />
      </column>
      <column caption='Share Effect' datatype='real' default-format='n#,##0' name='[Calculation_7310000000000000010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_7310000000000000013]) * (SUM([Calculation_7310000000000000012]) / SUM([Calculation_7310000000000000013]) - SUM([Units Year Earlier]) / SUM([Calculation_7310000000000000002]))' />
      </column>
      <column caption='Share Change (pts)' datatype='real' default-format='p0.0%' name='[Calculation_7310000000000000011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_7310000000000000012]) / SUM([Calculation_7310000000000000013]) - SUM([Units Year Earlier]) / SUM([Calculation_7310000000000000002])' />
      </column>
      <column-instance column='[Manufacturer]' derivation='None' name='[none:Manufacturer:nk]' pivot='key' type='nominal' />
      <column-instance column='[Product]' derivation='None' name='[none:Product:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Manufacturer:nk]' type='palette'>
            <map to='#2a78d6'>
              <bucket>&quot;Valley Central&quot;</bucket>
            </map>
            <map to='#eb6834'>
              <bucket>&quot;Neptune&quot;</bucket>
            </map>
            <map to='#1baf7a'>
              <bucket>&quot;Cornfield&quot;</bucket>
            </map>
            <map to='#eda100'>
              <bucket>&quot;Barefoot&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Product:nk]' type='palette'>
            <map to='#e87ba4'>
              <bucket>&quot;Rail&quot;</bucket>
            </map>
            <map to='#008300'>
              <bucket>&quot;Call&quot;</bucket>
            </map>
            <map to='#6250d6'>
              <bucket>&quot;Premium&quot;</bucket>
            </map>
            <map to='#e34948'>
              <bucket>&quot;Top Shelf&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
    </datasource>
